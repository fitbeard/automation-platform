From 8f85356f3e2b7f50791a1c896d19a3f57466037c Mon Sep 17 00:00:00 2001
From: AAP Rebuild <aap-rebuild-bot@localhost>
Date: Sun, 22 Nov 2026 00:43:33 +0200
Subject: [PATCH] patch: nginx Vite UI asset locations and hardening

Re-authored for eda-server-operator baseline (devel HEAD): the
eda-ui nginx configmap moved access_log to http-level, so the 2.6 anchors
shifted. Adds (eda-ui pod nginx): server-level security headers
(X-Frame-Options DENY, X-Content-Type-Options nosniff); /assets/eda-logo.svg
-> /eda-logo.svg rewrite; and a standalone /api/gateway/v1/* -> /api/eda/v1/*
rewrite gated on 'not ui_disabled'.
---
 roles/eda/templates/eda.configmap.yaml.j2 | 26 +++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/roles/eda/templates/eda.configmap.yaml.j2 b/roles/eda/templates/eda.configmap.yaml.j2
index a292455..5a93157 100644
--- a/roles/eda/templates/eda.configmap.yaml.j2
+++ b/roles/eda/templates/eda.configmap.yaml.j2
@@ -101,6 +101,10 @@ data:
             server_name _;
             server_tokens off;
 
+            # Security headers (server-level)
+            add_header X-Frame-Options "DENY" always;
+            add_header X-Content-Type-Options "nosniff" always;
+
             autoindex off;
 
             include mime.types;
@@ -112,6 +116,28 @@ data:
 
             root /usr/share/nginx/html;
 
+            # Vite UI emits /assets/eda-logo.svg as an absolute path but the
+            # file ships at /eda-logo.svg in the eda-ui image. Rewrite so the
+            # login masthead / About modal logo render.
+            location = /assets/eda-logo.svg {
+                rewrite ^ /eda-logo.svg last;
+            }
+
+            {% if not ui_disabled %}
+            # Standalone (no gateway in front): the EDA UI's shared Access
+            # components call /api/gateway/v1/* which in standalone live at
+            # /api/eda/v1/*. Rewrite + proxy. Gated on `not ui_disabled` (when
+            # ui_disabled the platform-UI/gateway fronts EDA and serves these).
+            location ~ ^/api/gateway/v1/(.*)$ {
+                rewrite ^/api/gateway/v1/(.*)$ /api/eda/v1/$1 break;
+                proxy_pass http://{{ api_server_name }}:{{ api_nginx_port }};
+                proxy_set_header Host $http_host;
+                proxy_set_header X-Forwarded-Proto $remote_scheme;
+                proxy_set_header X-Forwarded-Port $server_port;
+                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            }
+            {% endif %}
+
             location ~ ^/api/eda {
                 proxy_pass http://{{ api_server_name }}:{{ api_nginx_port }};
                 proxy_set_header Origin http://{{ api_server_name }}:{{ api_nginx_port }};
