From ea8cd09fd8b57491bf0ba05f006d0d3c426690ac Mon Sep 17 00:00:00 2001
From: AAP Rebuild <aap-rebuild-bot@localhost>
Date: Sat, 21 Nov 2026 10:31:21 +0200
Subject: [PATCH] patch: grant TokenRequest (serviceaccounts/token) RBAC for
 credential plugins

Downstream-only addition in platform-operator-bundle (not in public
ansible/awx-operator). Lets the operator mint audience-scoped, short-lived
SA tokens via the TokenRequest API for credential plugins such as HashiCorp
Vault Kubernetes auth, so the broad apiserver-audience default token is never
sent to a user-supplied endpoint.

Adds 'serviceaccounts/token: create' to both the operator Role
(config/rbac/role.yaml) and the per-instance Role template
(roles/installer/templates/rbac/service_account.yaml.j2).
---
 config/rbac/role.yaml                                  | 6 ++++++
 roles/installer/templates/rbac/service_account.yaml.j2 | 8 ++++++++
 2 files changed, 14 insertions(+)

diff --git a/config/rbac/role.yaml b/config/rbac/role.yaml
index 1a6ddb1..7fb95da 100644
--- a/config/rbac/role.yaml
+++ b/config/rbac/role.yaml
@@ -127,6 +127,12 @@ rules:
     verbs:
       - create
       - get
+  - apiGroups:
+      - ""
+    resources:
+      - serviceaccounts/token  # needed to be able to grant TokenRequest to the app service account
+    verbs:
+      - create
   - apiGroups:
       - apps
     resources:
diff --git a/roles/installer/templates/rbac/service_account.yaml.j2 b/roles/installer/templates/rbac/service_account.yaml.j2
index deb9e06..c68491a 100644
--- a/roles/installer/templates/rbac/service_account.yaml.j2
+++ b/roles/installer/templates/rbac/service_account.yaml.j2
@@ -31,6 +31,14 @@ rules:
 - apiGroups: [""]
   resources: ["secrets"]
   verbs: ["get", "create", "delete"]
+# Allow the control plane to mint audience-scoped, short-lived tokens for its
+# own ServiceAccount via the TokenRequest API. Used by credential plugins (e.g.
+# HashiCorp Vault Kubernetes auth) so that the broad, apiserver-audience default
+# token is never sent off-cluster to a user-supplied endpoint.
+- apiGroups: [""]
+  resources: ["serviceaccounts/token"]
+  resourceNames: ['{{ ansible_operator_meta.name }}']
+  verbs: ["create"]
 
 ---
 kind: RoleBinding
