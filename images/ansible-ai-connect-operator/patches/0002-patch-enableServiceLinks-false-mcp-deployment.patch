From 2261fbf89d5168fd9c0c056d08c597d8c2c6683d Mon Sep 17 00:00:00 2001
From: AAP Rebuild <aap-rebuild-bot@localhost>
Date: Tue, 8 Sep 2026 23:58:47 +0300
Subject: [PATCH] patch: enableServiceLinks=false on mcp-server Deployment
 (AAP-90657)

Complements the mcp-server MCP_PORT hardening (public commit 03876616): a
Service named 'mcp' in the namespace injects MCP_PORT=tcp://<ip>:<port> via
Kubernetes service links, clobbering the backend listen port -> NGINX 502.
Setting enableServiceLinks: false on the pod spec prevents that injection.

Upstream landed this 2026-09-02 (f761148), newer than the 2.6-1787258025
bundle cut (~2026-08-24); grafted as a local patch since it's the operator-side
half of the same fix we already shipped in the mcp-server image.
---
 roles/mcpserver/templates/mcpserver.deployment.yaml.j2 | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/roles/mcpserver/templates/mcpserver.deployment.yaml.j2 b/roles/mcpserver/templates/mcpserver.deployment.yaml.j2
index db0f9d0..6a26e2b 100644
--- a/roles/mcpserver/templates/mcpserver.deployment.yaml.j2
+++ b/roles/mcpserver/templates/mcpserver.deployment.yaml.j2
@@ -40,6 +40,11 @@ spec:
         checksum-{{ template | replace('/', '-') }}: "{{ lookup('template', template + '.yaml.j2') | sha1 }}"
 {% endfor %}
     spec:
+      # Disable Kubernetes service-link env injection: a Service named "mcp" in
+      # the namespace injects MCP_PORT=tcp://<ip>:<port>, clobbering the backend
+      # listen port and causing NGINX 502s. Pairs with the mcp-server MCP_PORT
+      # hardening (AAP-90657). Ports newer than the 2.6-1787258025 bundle cut.
+      enableServiceLinks: false
       serviceAccountName: '{{ ansible_operator_meta.name }}'
 {% if image_pull_secrets | length > 0 %}
       imagePullSecrets:
